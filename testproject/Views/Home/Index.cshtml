@{
    ViewData["Title"] = "Главная страница";
}

<div class="container mt-4">
    <div class="row">
        <!-- Основной контент -->
        <div class="col-lg-8 mb-4">
            <h1 class="display-4">Добро пожаловать!</h1>
            <p class="lead">Описание самой клевой соцсети</p>

            <div class="mt-5">
                <h2>Наши преимущества</h2>
                <ul class="list-group">
                    <li class="list-group-item">Удобный интерфейс</li>
                    <li class="list-group-item">Быстрая регистрация</li>
                    <li class="list-group-item">Много возможностей</li>
                </ul>
            </div>
        </div>

        <!-- Форма регистрации -->
        <div class="col-lg-4">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Быстрая регистрация</h4>
                </div>
                <div class="card-body p-4">
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <partial name="_RegisterPartial" model="new testproject.ViewModels.RegisterViewModel()" />
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <div class="mb-3">
                                <i class="bi bi-check-circle-fill text-success fs-1"></i>
                            </div>
                            <h5>Вы уже вошли как</h5>
                            <p class="fs-5 text-primary fw-bold">@User.Identity.Name</p>
                            <div class="mt-3">
                                <a href="@Url.Action("Profile", "Account")" class="btn btn-primary me-2">
                                    Профиль
                                </a>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger">
                                        Выйти
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ВСТРАИВАЕМ СТИЛИ ПРЯМО В СТРАНИЦУ БЕЗ СЕКЦИИ -->
<style>
    .card {
        border-radius: 10px;
        border: none;
    }

    .card-header {
        border-radius: 10px 10px 0 0 !important;
    }

    .registration-form input {
        border-radius: 5px;
        border: 1px solid #ddd;
        padding: 10px;
    }

        .registration-form input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

    .btn-primary {
        background: linear-gradient(45deg, #0d6efd, #0b5ed7);
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        font-weight: 500;
    }

    .list-group-item {
        border: none;
        padding: 10px 15px;
    }
</style>

@section Scripts {
    <!-- Подключаем скрипты валидации -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function() {
            // Анимация при фокусе
            $('input').on('focus', function() {
                $(this).parent().addClass('focused');
            }).on('blur', function() {
                $(this).parent().removeClass('focused');
            });

            // Проверка паролей в реальном времени
            $('#PasswordConfirm').on('keyup', function() {
                var password = $('#Password').val();
                var confirm = $(this).val();

                if (confirm.length > 0) {
                    if (password === confirm) {
                        $(this).css('border-color', '#28a745');
                    } else {
                        $(this).css('border-color', '#dc3545');
                    }
                }
            });
        });
    </script>
}