@model testproject.ViewModels.AccountViewModel
@{
    ViewData["Title"] = "Самая крутая соцсеть";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #6e8efb, #a777e3);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .app-container {
            width: 100%;
            max-width: 1200px;
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);
        }

        /* Верхняя часть */
        .header-section {
            padding: 40px;
            background: white;
            border-bottom: 1px solid #eee;
        }

        .main-title {
            color: #333;
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .main-subtitle {
            color: #666;
            font-size: 16px;
            line-height: 1.5;
        }

        /* Основной контент */
        .content-section {
            display: flex;
            min-height: 500px;
        }

        /* Левая часть - Вход */
        .login-section {
            flex: 1;
            padding: 40px;
            background: white;
            border-right: 1px solid #eee;
        }

        .login-title {
            color: #333;
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 30px;
        }

        .input-group {
            margin-bottom: 25px;
        }

        .input-label {
            display: block;
            color: #333;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 500;
        }

        .input-field {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 14px;
            background: #f9f9f9;
        }

            .input-field:focus {
                border-color: #6e8efb;
                outline: none;
                background: white;
            }

        .login-btn {
            background: #6e8efb;
            color: white;
            border: none;
            padding: 14px;
            border-radius: 5px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            transition: background 0.3s;
        }

            .login-btn:hover {
                background: #5d7dfa;
            }

        /* Правая часть - Регистрация */
        .register-section {
            flex: 1;
            padding: 40px;
            background: #f8f9ff;
        }

        .register-divider {
            text-align: center;
            margin-bottom: 30px;
            color: #555;
            font-size: 16px;
            font-weight: 500;
        }

        .register-title {
            color: #333;
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 25px;
            text-align: center;
        }

        .name-row {
            display: flex;
            gap: 15px;
            margin-bottom: 25px;
        }

        .name-field {
            flex: 1;
        }

        .birthday-section {
            margin-bottom: 25px;
        }

        .birthday-label {
            display: block;
            color: #333;
            margin-bottom: 10px;
            font-size: 14px;
            font-weight: 500;
        }

        /* Грид с номерами дней */
        .days-grid {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            gap: 8px;
            margin-bottom: 15px;
        }

        /* Исправленные медиа-запросы */
        @@media (max-width: 768px) {
            .days-grid {
                grid-template-columns: repeat(6, 1fr);
            }
        }

        @@media (max-width: 480px) {
            .days-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }

        .day-number {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: white;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 14px;
            color: #333;
            cursor: pointer;
            transition: all 0.2s;
        }

            .day-number:hover {
                border-color: #6e8efb;
                color: #6e8efb;
            }

            .day-number.selected {
                background: #6e8efb;
                color: white;
                border-color: #6e8efb;
            }

        .month-select {
            width: 150px;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            background: white;
            font-size: 14px;
        }

        .register-btn {
            background: #a777e3;
            color: white;
            border: none;
            padding: 14px;
            border-radius: 5px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            margin-top: 10px;
            transition: background 0.3s;
        }

            .register-btn:hover {
                background: #9666d6;
            }

        .error-message {
            color: #ff3333;
            font-size: 12px;
            margin-top: 5px;
            display: block;
        }

        /* Адаптивность */
        @@media (max-width: 900px) {
            .content-section {
                flex-direction: column;
            }

            .login-section {
                border-right: none;
                border-bottom: 1px solid #eee;
            }

            .header-section {
                padding: 30px;
            }

            .login-section, .register-section {
                padding: 30px;
            }
        }

        @@media (max-width: 480px) {
            .header-section {
                padding: 20px;
            }

            .login-section, .register-section {
                padding: 20px;
            }

            .name-row {
                flex-direction: column;
            }

            .main-title {
                font-size: 28px;
            }

            .login-title {
                font-size: 22px;
            }
        }
    </style>
</head>
<body>
    <div class="app-container">
        <!-- Верхняя часть с заголовком -->
        <div class="header-section">
            <h1 class="main-title">Пользуйтесь нашей самой крутой соцсетью!</h1>
            <p class="main-subtitle">Регистрируйтесь всего за 2 минуты, делитесь мыслями, находите новых друзей.</p>
        </div>

        <!-- Основной контент (две колонки) -->
        <div class="content-section">
            <!-- Левая колонка - Вход -->
            <div class="login-section">
                <h2 class="login-title">Добро пожаловать!</h2>

                <form asp-action="Login" method="post" id="loginForm">
                    <div class="input-group">
                        <label class="input-label">Введите email</label>
                        <input asp-for="LoginModel.Email" type="email" class="input-field" placeholder="example@mail.ru">
                        <span asp-validation-for="LoginModel.Email" class="error-message"></span>
                    </div>

                    <div class="input-group">
                        <label class="input-label">Введите пароль</label>
                        <input asp-for="LoginModel.Password" type="password" class="input-field" placeholder="••••••••">
                        <span asp-validation-for="LoginModel.Password" class="error-message"></span>
                    </div>

                    <button type="submit" class="login-btn">Войти</button>
                </form>
            </div>

            <!-- Правая колонка - Регистрация -->
            <div class="register-section">
                <div class="register-divider">Впервые с нами?</div>

                <h3 class="register-title">Регистрация нового пользователя</h3>

                <form asp-action="Register" method="post" id="registerForm">
                    <div class="name-row">
                        <div class="name-field">
                            <label class="input-label">Введите имя</label>
                            <input asp-for="RegisterModel.FirstName" type="text" class="input-field" placeholder="Иван">
                            <span asp-validation-for="RegisterModel.FirstName" class="error-message"></span>
                        </div>

                        <div class="name-field">
                            <label class="input-label">Введите фамилию</label>
                            <input asp-for="RegisterModel.LastName" type="text" class="input-field" placeholder="Иванов">
                            <span asp-validation-for="RegisterModel.LastName" class="error-message"></span>
                        </div>
                    </div>

                    <div class="birthday-section">
                        <label class="birthday-label">Дата рождения</label>

                        <!-- Грид с номерами дней -->
                        <div class="days-grid" id="daysGrid">
                            <!-- Дни будут добавлены через JavaScript -->
                        </div>

                        <div style="display: flex; align-items: center; gap: 15px; margin-top: 15px;">
                            <input type="hidden" asp-for="RegisterModel.BirthDay" id="selectedDayInput" />

                            <select asp-for="RegisterModel.BirthMonth" asp-items="Model.SelectLists.Months" class="month-select">
                                <option value="">Месяц</option>
                            </select>

                            <select asp-for="RegisterModel.BirthYear" asp-items="Model.SelectLists.Years" class="month-select">
                                <option value="">Год</option>
                            </select>
                        </div>

                        <span asp-validation-for="RegisterModel.BirthDay" class="error-message"></span>
                        <span asp-validation-for="RegisterModel.BirthMonth" class="error-message"></span>
                        <span asp-validation-for="RegisterModel.BirthYear" class="error-message"></span>
                    </div>

                    <div class="input-group">
                        <label class="input-label">Email</label>
                        <input asp-for="RegisterModel.Email" type="email" class="input-field" placeholder="example@mail.ru">
                        <span asp-validation-for="RegisterModel.Email" class="error-message"></span>
                    </div>

                    <div class="input-group">
                        <label class="input-label">Пароль</label>
                        <input asp-for="RegisterModel.Password" type="password" class="input-field" placeholder="••••••••">
                        <span asp-validation-for="RegisterModel.Password" class="error-message"></span>
                    </div>

                    <button type="submit" class="register-btn">Продолжить регистрацию</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Уведомления
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                    alert('@TempData["SuccessMessage"]');
            </text>
        }

            // Создаем сетку дней
            createDaysGrid();

            // Инициализируем выбранный день из модели
            const selectedDayInput = document.getElementById('selectedDayInput');
            if (selectedDayInput && selectedDayInput.value) {
                selectDay(parseInt(selectedDayInput.value));
            }
        });

        function createDaysGrid() {
            const grid = document.getElementById('daysGrid');
            if (!grid) return;

            // Очищаем контейнер
            grid.innerHTML = '';

            // Создаем 31 день
            for (let day = 1; day <= 31; day++) {
                const dayElement = document.createElement('div');
                dayElement.className = 'day-number';
                dayElement.textContent = day;
                dayElement.dataset.day = day;

                dayElement.addEventListener('click', function() {
                    selectDay(day);
                });

                grid.appendChild(dayElement);
            }
        }

        function selectDay(day) {
            // Убираем выделение у всех дней
            document.querySelectorAll('.day-number').forEach(el => {
                el.classList.remove('selected');
            });

            // Выделяем выбранный день
            const selectedDay = document.querySelector(`.day-number[data-day="${day}"]`);
            if (selectedDay) {
                selectedDay.classList.add('selected');

                // Устанавливаем значение в скрытое поле
                const selectedDayInput = document.getElementById('selectedDayInput');
                if (selectedDayInput) {
                    selectedDayInput.value = day;
                }
            }
        }

        // Обработка изменения месяца/года для валидации
        document.querySelectorAll('[name="RegisterModel.BirthMonth"], [name="RegisterModel.BirthYear"]').forEach(select => {
            select.addEventListener('change', function() {
                // Проверяем валидность даты
                const day = document.getElementById('selectedDayInput')?.value;
                const month = document.querySelector('[name="RegisterModel.BirthMonth"]')?.value;
                const year = document.querySelector('[name="RegisterModel.BirthYear"]')?.value;

                if (day && month && year) {
                    const selectedDate = new Date(year, month - 1, day);
                    if (selectedDate.getDate() != day || selectedDate.getMonth() + 1 != month) {
                        alert('Некорректная дата!');
                        document.getElementById('selectedDayInput').value = '';
                        document.querySelectorAll('.day-number').forEach(el => {
                            el.classList.remove('selected');
                        });
                    }
                }
            });
        });
    </script>
</body>
</html>